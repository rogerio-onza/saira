.claude/
.codex/
.agents/
scripts/*
!scripts/release_gate.R
!scripts/smoke_report.R
pkg_docs/

# Internal docs kept local, not published to the public repo
docs/roadmap.md
docs/archive/

# R / RStudio
.Rproj.user/
.Rhistory
.RData
.Ruserdata

# OS
.DS_Store
Thumbs.db

# Windows Mark-of-the-Web NTFS alternate-data-stream junk
*:Zone.Identifier

# Quarto website (site de ajuda em website/) — artefatos de build
website/_site/
website/.quarto/

# NOTE: the files generated by website/scripts/build_releases.py
# (_variables.yml, _releases-pt.md, _releases-en.md, assets/version.html) are
# committed on purpose — Quarto resolves {{< include >}} during its pre-scan,
# before the pre-render hook runs, so the partials must already exist on disk.
# The pre-render still refreshes them on every build, so the published site is
# always current even if a committed copy is stale.

/.quarto/
**/*.quarto_ipynb

# Python bytecode cache (website pre-render scripts)
__pycache__/
*.pyc

# Source spreadsheet for the invasive-species lookup. Not versioned: the
# generated inst/extdata/invasive_species.rds is what ships and what the app
# reads. To regenerate, drop the Instituto Horus CSV back at this path and run
# data-raw/generate_invasive_species.R.
data-raw/invasive_species_horus_2023.csv
